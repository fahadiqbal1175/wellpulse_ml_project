# Phase 6 (MLflow): regenerated by running the Phase 6 scripts, not
# something to commit — an interviewer cloning the repo runs
# `make baseline advanced tune register-model` (see README) to
# reproduce the full run/registry history locally.
mlflow.db
mlflow.db-journal
mlflow.db-wal
mlflow.db-shm

# Phase 8 (Database/Application Layer): local SQLite app DB — each
# environment grows its own via init_db() at startup, never shipped
# inside a zip/commit (same reasoning as mlflow.db above).
wellpulse_app.db
wellpulse_app.db-journal
wellpulse_app.db-wal
wellpulse_app.db-shm
